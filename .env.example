PORT=3000

# MySQL (local MySQL, RDS MySQL or Aurora MySQL all work)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oil_user
DB_PASSWORD=change_me
DB_NAME=oil_shop

# Razorpay  (Dashboard -> Settings -> API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks -> the secret you set there
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Admin panel login token. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=put_a_long_random_token_here

# Shipping (rupees)
SHIPPING_FEE=60
FREE_SHIPPING_ABOVE=999

SHOP_NAME=Latha Oil Mill

# Set to "netbanking" to show ONLY net banking in checkout.
# Leave empty to allow UPI, cards, net banking and wallets (everything except COD, which Razorpay never offers).
ONLY_METHOD=
